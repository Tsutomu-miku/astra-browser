# Unit tests for browser-layer services.
#
# Test categories:
#   - AstraWorkspaceService unit tests        (profile-keyed, uses TestingProfile)
#   - AstraFavoriteService unit tests         (profile-keyed, uses TestingProfile)
#   - AstraNoteService unit tests             (note CRUD + workspace association)
#   - AstraTabFeatures unit tests             (WebContentsUserData, needs content
#                                              test harness)
#   - AstraCommandDelegate unit tests         (command identity + observer pattern)
#   - AstraWorkspaceImportExport unit tests   (JSON validation + import/export)
#   - AstraFocusModeService unit tests        (focus mode + distraction blocklist)
#   - AstraMemorySaverService unit tests      (tab suspend + settings + observers)
#   - AstraPipService unit tests              (PiP state + size presets)
#   - AstraReadingListService unit tests      (reading list projection + observers)
#   - AstraScreenshotService unit tests       (screenshot capture + observers)
#   - AstraSessionRestoreHelper unit tests    (session metadata bridge)
#
# TODO(astra): Integrate these tests into the Chromium unit_tests target.
# Patch point: //chrome/test/BUILD.gn unit test suites.
# These tests depend on //chrome/test:test_support for TestingProfile and
# related test utilities.  They will not compile in a standalone overlay repo
# because they require the full Chromium checkout with test support libraries.
#
# TODO(astra): Add unit tests for astra_prefs (key registration + defaults).
source_set("astra_browser_unit_tests") {
  testonly = true

  sources = [
    "astra_accessibility_service_unittest.cc",
    "astra_autofill_helper_unittest.cc",
    "astra_command_delegate_unittest.cc",
    "astra_devtools_helper_unittest.cc",

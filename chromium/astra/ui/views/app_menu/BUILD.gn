import("//build/config/ui/views/views.gni")

component("astra_app_menu_views") {
  sources = [
    "astra_app_menu_view.cc",
    "astra_app_menu_view.h",
  ]

  defines = [ "ASTRA_APP_MENU_VIEWS_IMPLEMENTATION" ]

  deps = [
    "//base",
    "//skia",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
    "//ui/views/bubble",
    "//ui/views/controls",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "astra_app_menu_views_unittest.cc",
  ]

  deps = [
    ":astra_app_menu_views",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
    "//ui/views:views_test_support",
  ]
}

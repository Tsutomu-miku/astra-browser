# Unit and interactive UI tests for views-layer code.
#
# Test categories:
#   - Unit tests for individual views (e.g. AstraSidebarItemView,
#     AstraWorkspaceSwitcherView, AstraSplitView) using views_test_support
#     and views::test::ViewsTestBase.
#   - interactive_ui_tests for full BrowserView integration (e.g.
#     AstraSidebarView installed into BrowserView, command handling,
#     split view controller lifecycle).
#
# TODO(astra): Add unit tests for individual sidebar and split view widgets
# once the views layer has stable APIs and testable widgets.
# TODO(astra): Add interactive_ui_tests for AstraSidebarView,
# AstraBrowserView, and AstraSplitViewController once the views layer is
# wired into BrowserView.
# Use views::test::ViewsTestBase for unit tests and InteractiveViewsTestApi
# / InProcessBrowserTest for interactive tests.
#
# Patch point: //chrome/browser/ui/views/frame.
# Integration point: //chrome/test:interactive_ui_tests test suite.
source_set("astra_ui_views_tests") {
  testonly = true

  sources = [
    "astra_browser_view_unittest.cc",
    "command_palette/astra_command_palette_views_unittest.cc",

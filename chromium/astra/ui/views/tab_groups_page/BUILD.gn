import("//build/config/ui/views/views.gni")

component("astra_tab_groups_page_views") {
  sources = [
    "astra_tab_groups_page_model.cc",
    "astra_tab_groups_page_model.h",
    "astra_tab_groups_page_view.cc",
    "astra_tab_groups_page_view.h",
  ]

  defines = [ "ASTRA_TAB_GROUPS_PAGE_VIEWS_IMPLEMENTATION" ]

  deps = [
    "//base",
    "//skia",
    "//ui/base",
    "//ui/color",
    "//ui/events",
    "//ui/gfx",
    "//ui/native_theme",
    "//ui/views",
    "//ui/views/controls",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "astra_tab_groups_page_views_unittest.cc",
  ]

  deps = [
    ":astra_tab_groups_page_views",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
    "//ui/views:views_test_support",
  ]
}

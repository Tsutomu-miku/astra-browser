import("//build/config/ui/views/views.gni")

component("astra_split_view_views") {
  sources = [
    "astra_split_layout_picker_view.cc",
    "astra_split_layout_picker_view.h",
    "astra_split_layouts_model.cc",
    "astra_split_layouts_model.h",
    "astra_split_view.cc",
    "astra_split_view.h",
    "astra_split_view_controller.cc",
    "astra_split_view_controller.h",
    "astra_split_view_model.cc",
    "astra_split_view_model.h",
  ]

  defines = [ "ASTRA_SPLIT_VIEW_VIEWS_IMPLEMENTATION" ]

  deps = [
    "//base",
    "//skia",
    "//ui/base",
    "//ui/color",
    "//ui/events",
    "//ui/gfx",
    "//ui/native_theme",
    "//ui/views",
    "//ui/views/controls",
    "//ui/views/layout",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "astra_split_layouts_views_unittest.cc",
    "astra_split_view_unittest.cc",
  ]

  deps = [
    ":astra_split_view_views",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
    "//ui/views:views_test_support",
  ]
}

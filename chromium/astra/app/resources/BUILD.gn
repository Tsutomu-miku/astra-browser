# Astra app resources — GRD files and asset files.
#
# This target compiles Astra's GRD (GRIT Definition) resource files into
# binary resource packs (.pak files) that are loaded into ResourceBundle
# at browser startup.
#
# Resources include:
#   - Astra-specific UI strings (IDS_ASTRA_*)
#   - Astra app icons and sidebar icons
#   - WebUI page assets (HTML, CSS, JS for astra://newtab, etc.)
#
# Chromium subsystems reused:
#   - GRIT tool — compiles .grd/.grdp files into .pak and C++ headers
#   - ui::ResourceBundle — loads and serves resource packs at runtime
#   - content::URLDataSource — serves WebUI resources from ResourceBundle
#
# TODO(astra): Wire this target into Chromium's resource loading pipeline.
#   The astra_resources.pak file needs to be loaded into ResourceBundle
#   at startup.
#   Patch point: chrome/browser/ui/ui_features.cc or
#     chrome/app/chrome_main_delegate.cc — call
#     ResourceBundle::AddDataPackFromPath() for astra_resources.pak.
#   Chromium owner: ui/base/resource/resource_bundle.h
# =========================================================================

import("//build/config/chrome_build.gni")
import("//astra/build/buildflags.gni")
import("//tools/grit/grit_rule.gni")

# ---------------------------------------------------------------------------
# grit target — compiles astra_resources.grd into resource pack
# ---------------------------------------------------------------------------
#
# GRIT reads the .grd file and generates:
#   - astra_resources.h  — C++ header with IDR_* / IDS_* constants
#   - astra_resources.cc — compiled resource data (for embedding)
#   - astra_resources.pak — binary resource pack (loaded at runtime)
#
# In a full Chromium build, grit() is a template from //tools/grit/grit_rule.gni.
# In this overlay repo, the target structure is defined for reference.

grit("astra_resources") {
  source = "astra_resources.grd"

  # Generated outputs.
  outputs = [
    "grit/astra_resources.h",
    "grit/astra_resources.cc",
    "astra_resources.pak",
  ]

  # Grit deps — other resource files this depends on.
  # Source files referenced by the GRD (for build dependency tracking).
  deps = [
    # WebUI source files that are bundled into the resource pack
  ]

  # Inputs list — files that GRIT reads to produce outputs.
  # These are referenced by <structure> and <part> elements in the .grd.
  # TODO(astra): Add proper inputs list for grit build integration.
  #   inputs = [
  #     "astra_strings.grdp",
  #     "newtab/newtab.html",
  #     "newtab/newtab.css",
  #     "newtab/newtab.js",
  #     "settings/settings.html",
  #     "settings/settings.css",
  #     "settings/settings.js",
  #   ]

  # Enable GZip compression for WebUI HTML/CSS/JS resources.
  # The <structure> entries in the .grd already specify compress="gzip",
  # but we set the flag here too for clarity.
  enable_compression = true
}

# ---------------------------------------------------------------------------
# Manually maintained resource header (overlay repo scaffolding)
# ---------------------------------------------------------------------------
#
# In a full Chromium build, astra_resources.h is GENERATED by GRIT from
# astra_resources.grd and placed in the gen/ directory.  In this overlay
# repo, we maintain a copy of the header manually so that C++ code can
# reference IDR_* / IDS_* constants without running the grit tool.
#
# This source_set tracks the header for build completeness and makes it
# available to targets that depend on //astra/app/resources.
#
# TODO(astra): Remove this source_set when grit is fully integrated and
#   generates the header automatically.  At that point, depending on the
#   grit target (":astra_resources") is sufficient to get the header.
# Patch point: //tools/grit/grit_rule.gni — generates the header from .grd

source_set("astra_resources_headers") {
  sources = [
    "astra_resources.h",
  ]

  public_deps = [
    "//astra/build:buildflags",
  ]

  visibility = [
    "//astra/*",
    "//chrome/*",
  ]

  # Header-only target — nothing to compile, just tracked for completeness.
}

# ---------------------------------------------------------------------------
# resources target — public_deps target for other targets to depend on
# ---------------------------------------------------------------------------
#
# This is the target that other targets (like astra/ui/webui) depend on
# to get the generated resource header and the .pak file.
#
# In Chromium patterns, resource targets are typically depended on via
# grit("foo") and the generated header is available at "grit/foo.h".
# We provide a group() target that other astra targets can depend on.

group("resources") {
  public_deps = [
    ":astra_resources",
    ":astra_resources_headers",
  ]

  visibility = [
    "//astra/*",
    "//chrome/*",
  ]
}

# ---------------------------------------------------------------------------
# Source files referenced by the GRD (for build dependency tracking)
# ---------------------------------------------------------------------------
#
# GRIT processes these source files and includes them in the .pak.
# Listed here for documentation and potential depfile generation.
#
# WebUI resources:
#   - newtab/newtab.html
#   - newtab/newtab.css
#   - newtab/newtab.js
#   - settings/settings.html
#   - settings/settings.css
#   - settings/settings.js
#
# String tables:
#   - astra_strings.grdp

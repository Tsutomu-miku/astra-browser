--- a/chrome/browser/sessions/session_restore.cc
+++ b/chrome/browser/sessions/session_restore.cc
@@ -30,6 +30,11 @@
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/sessions/session_restore.h"

+#if BUILDFLAG(IS_ASTRA_BRANDED)
+#include "astra/browser/astra_session_restore_helper.h"
+#endif
+
 // ... other includes ...

 namespace {
@@ -620,6 +625,17 @@ void SessionRestore::RestoredTab::CreateWebContents(
   // ... create WebContents, restore navigation state, etc. ...
   web_contents_ = content::WebContents::Create(create_params);

+#if BUILDFLAG(IS_ASTRA_BRANDED)
+  // Apply Astra per-tab metadata from the saved session data.
+  // This restores workspace ID, favorite state, split view configuration,
+  // and other Astra-specific tab metadata.
+  const base::Value::Dict& astra_metadata = session_tab_->extra_data;
+  if (astra::HasAstraMetadata(astra_metadata)) {
+    astra::AstraSessionRestoreHelper::OnWillRestoreTab(
+        profile_, web_contents_.get(), astra_metadata);
+  }
+#endif
+
   // ... insert into tab strip, etc. ...
 }

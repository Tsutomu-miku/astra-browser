diff --git a/chrome/browser/sessions/base_session_service.cc b/chrome/browser/sessions/base_session_service.cc
index abc1234..def5678 100644
--- a/chrome/browser/sessions/base_session_service.cc
+++ b/chrome/browser/sessions/base_session_service.cc
@@ -25,6 +25,11 @@
 #include "chrome/browser/sessions/session_service_base.h"
 #include "content/public/browser/web_contents.h"

+#if BUILDFLAG(IS_ASTRA_BRANDED)
+#include "astra/browser/astra_session_restore_helper.h"
+#endif
+
 // ... other includes ...

 namespace {
@@ -210,6 +215,15 @@ std::unique_ptr<sessions::SessionTab>
   tab->current_navigation_index = current_index;
   // ... populate navigations, pinned state, etc. ...

+#if BUILDFLAG(IS_ASTRA_BRANDED)
+  // Attach Astra per-tab metadata (workspace ID, favorite state, split view,
+  // etc.) to the session tab.  This metadata rides along with Chromium's
+  // session data and is restored when the tab is recreated.
+  base::Value::Dict astra_metadata =
+      astra::AstraSessionRestoreHelper::OnWillSaveTab(web_contents);
+  if (!astra_metadata.empty()) {
+    tab->extra_data.Merge(std::move(astra_metadata));
+  }
+#endif
+
   return tab;
 }
diff --git a/chrome/browser/sessions/session_restore.cc b/chrome/browser/sessions/session_restore.cc

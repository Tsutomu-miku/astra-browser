+//
+// Individual Astra command IDs are defined in astra/browser/astra_command_delegate.h
+// and use the astra::AstraCommandId enum.
+//
+// Range reservation is build-flag gated; plain Chromium builds have no
+// knowledge of these IDs.
+#define IDC_ASTRA_FIRST 60000
+#define IDC_ASTRA_LAST  60999
+#endif

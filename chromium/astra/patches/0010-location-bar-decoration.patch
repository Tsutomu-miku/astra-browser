+
   // ... other decorations ...
   // AddPageInfoView_ = AddChildView(...);
@@ -420,6 +438,20 @@ void LocationBarView::Update() {
     translate_icon_view_->SetIcon();
   }

+#if BUILDFLAG(IS_ASTRA_BRANDED)
+  // Update Astra workspace decoration with current workspace state.
+  // Reads the active workspace from AstraWorkspaceService and updates
+  // the decoration view with the workspace name and accent color.
+  if (astra_decoration_view_) {
+    astra::AstraWorkspaceService* workspace_service =
+        astra::AstraWorkspaceServiceFactory::GetForProfile(
+            browser_->profile());
+    if (workspace_service) {
+      const astra::AstraWorkspace* active =
+          workspace_service->GetWorkspace(
+              workspace_service->active_workspace_id());
+      if (active) {
+        astra_decoration_view_->UpdateWorkspace(active->name,
+                                                active->accent_color);
+      }
+    }
+    astra_decoration_view_->SetDecorationVisible(true);
+  }
+#endif
+

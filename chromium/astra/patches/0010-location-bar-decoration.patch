 LocationBarView::LocationBarView(Browser* browser,
@@ -125,6 +130,19 @@ void LocationBarView::Init() {
   // ... create star_view_, translate_icon_view_, etc. ...
   star_view_ = AddChildView(std::make_unique<StarView>(browser_));

+#if BUILDFLAG(IS_ASTRA_BRANDED)
+  // Astra workspace indicator decoration on the leading edge of the omnibox.
+  // Shows the current workspace's accent color and name.
+  // Clicking opens the workspace switcher or command palette.
+  astra_decoration_view_ = AddChildView(
+      std::make_unique<astra::AstraLocationBarDecorationView>(
+          astra::AstraLocationBarDecorationView::Edge::kLeading));
+  astra_decoration_view_->SetProperty(
+      views::kElementIdentifierKey, kLocationBarAstraDecorationElementId);

 // ============================================================================
 // Accelerator table getter
@@ -520,6 +524,19 @@ base::span<const AcceleratorMapping> GetAcceleratorTable() {
   // ... build the table for the current platform ...
   // In newer Chromium, this returns a span directly from kAcceleratorMap.

+#if BUILDFLAG(IS_ASTRA_BRANDED)
+  // Append Astra-specific accelerators to the Chrome accelerator table.
+  //
+  // Astra commands live in the 60000+ command ID range (see
+  // astra/browser/astra_command_delegate.h).  Keyboard shortcuts for
+  // these commands are defined in astra/app/astra_accelerator_table.cc
+  // and are merged here so they are processed by FocusManager and
+  // dispatched through BrowserCommandController.
+  //
+  // The merge happens at runtime because the Astra table is a separate
+  // array; alternatively, the table could be concatenated at compile time.
+  // TODO(astra): Consider compile-time concatenation for performance.
+  static std::vector<AcceleratorMapping> merged_table;
+  if (merged_table.empty()) {
+    merged_table.assign(std::begin(kAcceleratorMap), std::end(kAcceleratorMap));
+    for (const auto& entry : astra::GetAstraAcceleratorTable()) {
+      AcceleratorMapping mapping;
+      mapping.keycode = entry.keycode;
+      mapping.modifiers = entry.modifiers;
+      mapping.command_id = entry.command_id;
+      merged_table.push_back(mapping);
+    }
+  }
+  return base::make_span(merged_table);
+#else
   return base::make_span(kAcceleratorMap);
+#endif
 }

